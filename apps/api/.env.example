# Copy this file to .env and change values if needed.
PORT=4000
DATABASE_URL="postgresql://mdarj:mdarj@localhost:5432/mdarj?schema=public"

# Email (FND-05). Locally: Mailpit, started by `pnpm db:up`; read the mail at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MDARJ <no-reply@mdarj.local>"
MAILPIT_URL="http://localhost:8025"

# Demo Admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@demo.mdarj.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
