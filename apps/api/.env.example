# Copy this file to .env and change values if needed.
PORT=4000
DATABASE_URL="postgresql://mdarj:mdarj@localhost:5432/mdarj?schema=public"

# Email (FND-05). Locally: Mailpit, started by `pnpm db:up`; read the mail at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MDARJ <no-reply@mdarj.local>"
MAILPIT_URL="http://localhost:8025"

# The web app's address, used to build invite links (UA-01)
WEB_URL="http://localhost:3000"

# Demo Admin created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@demo.mdarj.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Which proxies may tell the API the visitor's IP (FR-AT-2, D-73). Leave empty locally: the
# X-Forwarded-For header is then ignored, because a browser can fake it. Set it when the hosting
# is chosen: the number of proxies that ADD the visitor's IP (e.g. "1" for one load balancer;
# Next.js adds nothing), or their addresses ("10.0.0.0/8"). Never "true".
TRUSTED_PROXY=""
