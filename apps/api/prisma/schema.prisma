generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Lists of allowed values (enums) ─────────

enum UserRole {
  admin
  employee
  interviewer
}

enum UserStatus {
  invited
  active
  deactivated
}

enum Gender {
  male
  female
}

enum EmploymentType {
  full_time
  part_time
  trainee
}

enum EmployeeStatus {
  active
  suspended
  terminated
}

enum ContractType {
  indefinite
  fixed_term
  trainee
  part_time
}

enum DailyRateDivisor {
  days_30
  days_26
  working_days
}

// What kind of record an audit entry is about (SRS FR-DB-4)
enum AuditEntity {
  company_settings
  salary
  employee_status
  contract
  document
  user
  attendance_record
  leave_request
  leave_balance
  exception
  payroll_run
}

// What happened to that record
enum AuditAction {
  create
  update
  delete
  approve
  reject
  reopen
}

// ───────── Same-company links (D-48, FND-12) ─────────
//
// A row that points at another company-owned row stores BOTH ids: the target's id and its own
// companyId. The foreign key checks the pair, so the database itself refuses a link to a row of
// another company. That is why each target table has @@unique([id, companyId]) and each link
// reads: @relation(fields: [xId, companyId], references: [id, companyId]).

// ───────── Company and its settings ─────────

model Company {
  id               String   @id @default(uuid())
  name             String
  logo             String?
  address          String?
  phone            String?
  timeZone         String   @default("Africa/Cairo") @map("time_zone")
  currency         String   @default("EGP")
  lawMode          Boolean  @default(false) @map("law_mode")
  companyRulesText String?  @map("company_rules_text")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  settingsVersions CompanySettingsVersion[]
  users            User[]
  jobTitles        JobTitle[]
  employees        Employee[]
  salaryHistory    SalaryHistory[]
  statusHistory    EmployeeStatusHistory[]
  documents        Document[]
  contracts        Contract[]
  sessions         Session[]
  auditLogs        AuditLog[]

  @@map("companies")
}

model CompanySettingsVersion {
  id                    String           @id @default(uuid())
  companyId             String           @map("company_id")
  company               Company          @relation(fields: [companyId], references: [id])
  effectiveFrom         DateTime         @map("effective_from") @db.Date
  restDays              Int[]            @map("rest_days")
  dailyRateDivisor      DailyRateDivisor @default(days_30) @map("daily_rate_divisor")
  latenessPolicy        Json             @map("lateness_policy")
  overtimeDayRate       Decimal          @default(1.35) @map("overtime_day_rate") @db.Decimal(4, 2)
  overtimeNightRate     Decimal          @default(1.70) @map("overtime_night_rate") @db.Decimal(4, 2)
  overtimeRestDayRate   Decimal          @default(2.00) @map("overtime_rest_day_rate") @db.Decimal(4, 2)
  overtimeHolidayRate   Decimal          @default(2.00) @map("overtime_holiday_rate") @db.Decimal(4, 2)
  overtimeMinMinutes    Int              @default(30) @map("overtime_min_minutes")
  contractExpiringDays  Int              @default(30) @map("contract_expiring_days")
  checkInWindowMinutes  Int              @default(60) @map("check_in_window_minutes")
  checkOutWindowMinutes Int              @default(360) @map("check_out_window_minutes")
  ipAllowList           String[]         @map("ip_allow_list")
  createdById           String?          @map("created_by")
  createdBy             User?            @relation(fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt             DateTime         @default(now()) @map("created_at")

  @@unique([companyId, effectiveFrom])
  @@map("company_settings_versions")
}

// ───────── Users (logins) ─────────

model User {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  name            String?
  company         Company    @relation(fields: [companyId], references: [id])
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  role            UserRole
  status          UserStatus @default(invited)
  employeeId      String?    @map("employee_id")
  employee        Employee?  @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  inviteToken     String?    @unique @map("invite_token")
  inviteExpiresAt DateTime?  @map("invite_expires_at")
  language        String     @default("ar")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  sessions        Session[]

  // What this user recorded (the "who" columns on other tables)
  settingsVersionsCreated CompanySettingsVersion[]
  salaryRowsCreated       SalaryHistory[]
  statusChangesMade       EmployeeStatusHistory[]
  documentsUploaded       Document[]
  auditEntries            AuditLog[]

  @@unique([id, companyId])
  @@unique([employeeId, companyId]) // one login per employee
  @@map("users")
}

// ───────── Employees ─────────

model JobTitle {
  id        String     @id @default(uuid())
  companyId String     @map("company_id")
  company   Company    @relation(fields: [companyId], references: [id])
  nameAr    String     @map("name_ar")
  nameEn    String     @map("name_en")
  employees Employee[]

  @@unique([id, companyId])
  @@map("job_titles")
}

model Employee {
  id                String         @id @default(uuid())
  companyId         String         @map("company_id")
  company           Company        @relation(fields: [companyId], references: [id])
  code              String
  nameAr            String         @map("name_ar")
  nameEn            String         @map("name_en")
  nationalId        String?        @map("national_id")
  birthDate         DateTime?      @map("birth_date") @db.Date
  gender            Gender?
  phone             String?
  email             String?
  address           String?
  emergencyName     String?        @map("emergency_name")
  emergencyPhone    String?        @map("emergency_phone")
  photo             String?
  jobTitleId        String?        @map("job_title_id")
  jobTitle          JobTitle?      @relation(fields: [jobTitleId, companyId], references: [id, companyId], onDelete: Restrict)
  employmentType    EmploymentType @map("employment_type")
  hireDate          DateTime       @map("hire_date") @db.Date
  probationEnd      DateTime?      @map("probation_end") @db.Date
  trainingEnd       DateTime?      @map("training_end") @db.Date
  status            EmployeeStatus @default(active)
  terminationDate   DateTime?      @map("termination_date") @db.Date
  terminationReason String?        @map("termination_reason")
  hasDisability     Boolean        @default(false) @map("has_disability")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user          User?
  salaryHistory SalaryHistory[]
  statusHistory EmployeeStatusHistory[]
  contracts     Contract[]
  documents     Document[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("employees")
}

model SalaryHistory {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id])
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId, companyId], references: [id, companyId])
  baseSalary    Decimal  @map("base_salary") @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   String?  @map("created_by")
  createdBy     User?    @relation(fields: [createdById, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([employeeId, effectiveFrom])
  @@map("salary_history")
}

model EmployeeStatusHistory {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id])
  employeeId    String          @map("employee_id")
  employee      Employee        @relation(fields: [employeeId, companyId], references: [id, companyId])
  fromStatus    EmployeeStatus? @map("from_status")
  toStatus      EmployeeStatus  @map("to_status")
  effectiveDate DateTime        @map("effective_date") @db.Date
  reason        String?
  changedById   String?         @map("changed_by")
  changedBy     User?           @relation(fields: [changedById, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("employee_status_history")
}

// An employee's document (D-47). A candidate_id column joins in MVP-2 with the candidates table.
model Document {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  company      Company   @relation(fields: [companyId], references: [id])
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId, companyId], references: [id, companyId])
  docType      String    @map("doc_type")
  fileKey      String    @map("file_key")
  expiryDate   DateTime? @map("expiry_date") @db.Date
  uploadedById String?   @map("uploaded_by")
  uploadedBy   User?     @relation(fields: [uploadedById, companyId], references: [id, companyId], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("documents")
}

model Contract {
  id                 String       @id @default(uuid())
  companyId          String       @map("company_id")
  company            Company      @relation(fields: [companyId], references: [id])
  employeeId         String       @map("employee_id")
  employee           Employee     @relation(fields: [employeeId, companyId], references: [id, companyId])
  type               ContractType
  startDate          DateTime     @map("start_date") @db.Date
  endDate            DateTime?    @map("end_date") @db.Date
  agreedSalary       Decimal?     @map("agreed_salary") @db.Decimal(12, 2)
  fileKey            String?      @map("file_key")
  previousContractId String?      @map("previous_contract_id")
  previousContract   Contract?    @relation("ContractRenewal", fields: [previousContractId, companyId], references: [id, companyId], onDelete: Restrict)
  renewedBy          Contract?    @relation("ContractRenewal")
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([id, companyId])
  @@unique([previousContractId, companyId]) // a contract is renewed at most once
  @@map("contracts")
}

// ───────── Sessions (D-24) ─────────

// One row per logged-in browser. The cookie holds a random token; only its hash is stored here.
model Session {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  company    Company   @relation(fields: [companyId], references: [id])
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId, companyId], references: [id, companyId])
  tokenHash  String    @unique @map("token_hash")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ───────── Audit log (FND-07, FR-DB-4, NFR-8) ─────────
//
// One row per audited change. Rows are only ever added: never updated or deleted.

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String      @map("company_id")
  company    Company     @relation(fields: [companyId], references: [id])
  userId     String?     @map("user_id") // null = a scheduled job, not a person
  user       User?       @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  entityType AuditEntity @map("entity_type")
  entityId   String      @map("entity_id") // the id of the changed row (any table, so no foreign key)
  action     AuditAction
  before     Json? // null when the record was created
  after      Json? // null when the record was deleted
  reason     String? // required by the service for punch corrections and payroll reopens
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([companyId, createdAt]) // the audit viewer: newest first, per company
  @@index([entityType, entityId]) // the history of one record
  @@map("audit_log")
}
